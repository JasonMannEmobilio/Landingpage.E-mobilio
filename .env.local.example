# Copy to .env.local and fill in. Never commit .env.local.
# NOTE: .env.local.example IS committed, so keep real credentials out of this file.

# --- EVC-net Platform API ---
LMS_BASE_URL=https://e-mobilio.evc-net.com
# Base64 of "client_id:client_secret". With or without a leading "Basic " — both work.
LMS_AUTH_BASIC_TOKEN=
# NOTE: the LMS usergroup is NOT set here — each partner has its own "usergroupId"
# in config/partners/<slug>.json.

# --- Activation links ---
# Signs the token in the activation email. Any random string, min 16 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTIVATION_TOKEN_SECRET=
# Used to build absolute links in emails. Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Xano (admin + partner storage) ---
# API group URL, e.g. https://x123-abcd-efgh.xano.io/api:AbC1dEf2
# Leave blank and the app falls back to the JSON files in config/partners/.
XANO_BASE_URL=
# Server-side only — never rename this to NEXT_PUBLIC_*.
XANO_API_KEY=
# Hostname only, for next/image. Required if logos/card images are stored in Xano.
XANO_IMAGE_HOST=
# Path of a Xano endpoint that accepts an image and returns its file resource,
# e.g. /upload/image. Leave blank to disable uploads (paths in public/ still work).
XANO_UPLOAD_PATH=

# --- Email (SendGrid) ---
# Leave SENDGRID_API_KEY blank and emails are printed to the server console
# instead of sent, which is enough to test the full flow locally.
SENDGRID_API_KEY=
# Must be a sender SendGrid has verified (single sender or authenticated domain),
# otherwise every send is rejected with 403.
MAIL_FROM=
MAIL_FROM_NAME=e-mobilio
# Optional: where customer replies go.
MAIL_REPLY_TO=
# Optional: SendGrid dynamic template ids (d-xxxxxxxx). If set, these replace the
# built-in HTML. Merge fields: firstName, companyName, activationUrl / cardNumber.
SENDGRID_TEMPLATE_VERIFICATION=
SENDGRID_TEMPLATE_ACTIVATION=
